<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/overlay_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">
        <ImageView
            android:id="@+id/block_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_hourglass"
            android:tint="#FFFFFF"
            android:alpha="0.9"
            android:scaleType="fitCenter"
            android:layout_marginBottom="24dp"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/block_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_limiter_block_title"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />
        <TextView
            android:id="@+id/block_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_limiter_block_message"
            android:textColor="#CCCCCC"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/block_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_limiter_block_detail"
            android:textColor="#99FFFFFF"
            android:textSize="16sp"
            android:gravity="center" />

        <Button
            android:id="@+id/block_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/block_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#66FFFFFF"
        android:textSize="14sp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp" />
</FrameLayout>
